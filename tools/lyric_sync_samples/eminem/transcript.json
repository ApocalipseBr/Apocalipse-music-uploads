  "segments": [
    {
      "start": 30.0,
      "end": 31.48,
      "text": " I mean, right? Nope.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 32.14,
      "end": 34.42,
      "text": " Tall wall is dope, and some's bop-a-so.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 34.9,
      "end": 36.0,
      "text": " Bop-a-blah-blah-blah-blah-blah.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 36.0,
      "end": 37.4,
      "text": " Bop-a-blah-blah-blah-blah-blah.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 37.4,
      "end": 39.519999999999996,
      "text": " I don't compete with nobody.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 40.019999999999996,
      "end": 42.06,
      "text": " I just go hard, do the rope-a-dope.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 42.28,
      "end": 44.54,
      "text": " I least shuffle, and dance around my opponents.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 44.84,
      "end": 46.480000000000004,
      "text": " Do donuts, sometimes I play possum.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 46.64,
      "end": 47.96,
      "text": " Like I'm asleep, it's awesome.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 48.08,
      "end": 51.08,
      "text": " I'm like a sleeping giant, and when I wake, I'm like Dre.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 51.36,
      "end": 53.980000000000004,
      "text": " I just jump from out of nowhere and bite-brake.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 54.2,
      "end": 55.8,
      "text": " It's like I'm seething them and fill them.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 55.980000000000004,
      "end": 59.34,
      "text": " Full of poison, and making noise like a snake before I kill them.",
      "avg_logprob": -0.3040757972483683,
      "no_speech_prob": 0.6084977984428406
    },
    {
      "start": 59.34,
      "end": 61.66,
      "text": " And let him know that I just don't feel him",
      "avg_logprob": -0.4937650833600833,
      "no_speech_prob": 0.15430964529514313
    },
    {
      "start": 61.66,
      "end": 63.46,
      "text": " And smack him with the back with his",
      "avg_logprob": -0.4937650833600833,
      "no_speech_prob": 0.15430964529514313
    },
    {
      "start": 63.46,
      "end": 66.24000000000001,
      "text": " Eminem and Bella, mama's torn up your gun",
      "avg_logprob": -0.4937650833600833,
      "no_speech_prob": 0.15430964529514313
    },
    {
      "start": 66.24000000000001,
      "end": 68.16,
      "text": " And murder somebody, you should face him",
      "avg_logprob": -0.4937650833600833,
      "no_speech_prob": 0.15430964529514313
    },
    {
      "start": 68.16,
      "end": 70.2,
      "text": " Tell him why I look him dead in the eye",
      "avg_logprob": -0.4937650833600833,
      "no_speech_prob": 0.15430964529514313
    },
    {
      "start": 70.2,
      "end": 71.08,
      "text": " Then waste him",
      "avg_logprob": -0.4937650833600833,
