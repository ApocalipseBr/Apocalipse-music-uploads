{
  "private": true,
  "scripts": {
    "clean": "node tools/build.mjs --clean",
    "build": "node tools/build.mjs",
    "update": "pzstudio update",
    "generate:catalog": "python Apocalipse-Music-uploads/tools/generate_amp_registry.py",
    "check:assets": "python Apocalipse-Music-uploads/tools/generate_amp_registry.py --check",
    "test": "npm run test:python && npm run test:lua",
    "test:python": "python -m unittest discover -s tests -p test_*.py -v",
    "test:lua": "node tests/startup_spec.js",
    "test:startup": "node tests/startup_spec.js",
    "test:build": "python tools/validate_build.py"
  },
  "devDependencies": {
    "fengari": "0.1.5",
    "fengari-node-cli": "0.1.0",
    "pzstudio": "2.2.0"
  }
}
